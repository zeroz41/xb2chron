#ifndef STRING_LIBCXX_H
#define STRING_LIBCXX_H

// The C++ library's std::string, as the SDK's libc++ 3.9.1 writes it (std::__1, little-endian default layout).
// basic_string<char> is explicitly instantiated in the SDK's library (_LIBCPP_EXTERN_TEMPLATE): its non-inline
// members (__init, the destructor) are imported, so they are only declared here. Only what the game's code uses.
#include <__config>
#include <__functional_base>
#include <memory>
#include <stddef.h>
#include <string.h>

namespace std { inline namespace __1 {

template <class _CharT>
struct char_traits;

template <>
struct char_traits<char> {
    typedef char char_type;
    static inline size_t length(const char_type* __s) { return strlen(__s); }
    static inline int compare(const char_type* __s1, const char_type* __s2, size_t __n) {
        if (__n == 0)
            return 0;
        return memcmp(__s1, __s2, __n);
    }
};

template <class _CharT, class _Traits = char_traits<_CharT>, class _Allocator = allocator<_CharT> >
class basic_string {
public:
    typedef _Traits traits_type;
    typedef _CharT value_type;
    typedef size_t size_type;
    typedef value_type* pointer;
    typedef const value_type* const_pointer;

private:
    struct __long {
        size_type __cap_;
        size_type __size_;
        pointer __data_;
    };

    enum { __short_mask = 0x01 };
    enum { __long_mask = 0x1ul };

    enum { __min_cap = (sizeof(__long) - 1) / sizeof(value_type) > 2 ? (sizeof(__long) - 1) / sizeof(value_type) : 2 };

    struct __short {
        union {
            unsigned char __size_;
            value_type __lx;
        };
        value_type __data_[__min_cap];
    };

    union __ulx {
        __long __lx;
        __short __lxx;
    };

    enum { __n_words = sizeof(__ulx) / sizeof(size_type) };

    struct __raw {
        size_type __words[__n_words];
    };

    struct __rep {
        union {
            __long __l;
            __short __s;
            __raw __r;
        };
    };

    // libc++ keeps the representation and the (empty) allocator in a __compressed_pair, value-initialized by the
    // constructors; the allocator takes no space, so the representation alone is stored here.
    __rep __r_;

public:
    _LIBCPP_INLINE_VISIBILITY basic_string(const _CharT* __s) : __r_() { __init(__s, traits_type::length(__s)); }
    _LIBCPP_INLINE_VISIBILITY basic_string(basic_string&& __str) noexcept : __r_(__str.__r_) { __str.__zero(); }
    ~basic_string();

    _LIBCPP_INLINE_VISIBILITY size_type size() const noexcept {
        return __is_long() ? __get_long_size() : __get_short_size();
    }
    _LIBCPP_INLINE_VISIBILITY const value_type* data() const noexcept { return __get_pointer(); }

    _LIBCPP_INLINE_VISIBILITY bool __is_long() const noexcept { return bool(__r_.__s.__size_ & __short_mask); }

private:
    _LIBCPP_INLINE_VISIBILITY size_type __get_short_size() const noexcept { return __r_.__s.__size_ >> 1; }
    _LIBCPP_INLINE_VISIBILITY size_type __get_long_size() const noexcept { return __r_.__l.__size_; }
    _LIBCPP_INLINE_VISIBILITY const_pointer __get_long_pointer() const noexcept { return __r_.__l.__data_; }
    _LIBCPP_INLINE_VISIBILITY const_pointer __get_short_pointer() const noexcept { return &__r_.__s.__data_[0]; }
    _LIBCPP_INLINE_VISIBILITY const_pointer __get_pointer() const noexcept {
        return __is_long() ? __get_long_pointer() : __get_short_pointer();
    }
    _LIBCPP_INLINE_VISIBILITY void __zero() noexcept {
        size_type(&__a)[__n_words] = __r_.__r.__words;
        for (unsigned __i = 0; __i < __n_words; ++__i)
            __a[__i] = 0;
    }

    void __init(const value_type* __s, size_type __sz);
};

typedef basic_string<char> string;

template <class _Allocator>
inline _LIBCPP_INLINE_VISIBILITY bool operator==(const basic_string<char, char_traits<char>, _Allocator>& __lhs,
                                                 const basic_string<char, char_traits<char>, _Allocator>& __rhs) noexcept {
    size_t __lhs_sz = __lhs.size();
    if (__lhs_sz != __rhs.size())
        return false;
    const char* __lp = __lhs.data();
    const char* __rp = __rhs.data();
    if (__lhs.__is_long())
        return char_traits<char>::compare(__lp, __rp, __lhs_sz) == 0;
    for (; __lhs_sz != 0; --__lhs_sz, ++__lp, ++__rp)
        if (*__lp != *__rp)
            return false;
    return true;
}

template <class _Ptr>
size_t _LIBCPP_INLINE_VISIBILITY __do_string_hash(_Ptr __p, _Ptr __e) {
    return __murmur2_or_cityhash<size_t>()(__p, (__e - __p) * sizeof(*__p));
}

template <class _CharT, class _Traits, class _Allocator>
struct hash<basic_string<_CharT, _Traits, _Allocator> > {
    size_t operator()(const basic_string<_CharT, _Traits, _Allocator>& __val) const noexcept;
};

template <class _CharT, class _Traits, class _Allocator>
size_t hash<basic_string<_CharT, _Traits, _Allocator> >::operator()(
    const basic_string<_CharT, _Traits, _Allocator>& __val) const noexcept {
    return __do_string_hash(__val.data(), __val.data() + __val.size());
}

}}  // namespace std::__1

#endif
