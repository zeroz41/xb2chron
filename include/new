#ifndef NEW_H
#define NEW_H

// The C++ library's placement forms, as the SDK's <new> defines them.
#include <stddef.h>

namespace std {
struct nothrow_t {};
extern const nothrow_t nothrow;
}  // namespace std

void* operator new(size_t, const std::nothrow_t&) noexcept;

inline void* operator new(size_t, void* place) noexcept {
    return place;
}
inline void* operator new[](size_t, void* place) noexcept {
    return place;
}

#endif
